# Copy this file to .env and fill in the keys you want to use.

# Chat replies. Create a key at https://build.nvidia.com/
NVIDIA_API_KEY=

# Weather. Create a key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# NASA picture of the day. Create a key at https://api.nasa.gov/
NASA_API_KEY=

# nim uses the NVIDIA key. local downloads a small model and needs extra packages.
JARVIS_LLM_MODE=nim
JARVIS_NIM_MODEL=meta/muse-glimmer-30b
